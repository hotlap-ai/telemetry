{
  "name": "@hotlap.ai/telemetry",
  "version": "1.0.0",
  "description": "High-performance iRacing telemetry library for Bun - IBT file parsing and live data streaming",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ibt": {
      "types": "./dist/ibt.d.ts",
      "import": "./dist/ibt.js",
      "default": "./dist/ibt.js"
    },
    "./core": {
      "types": "./dist/ibt.d.ts",
      "import": "./dist/neutral/ibt.js",
      "default": "./dist/neutral/ibt.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/neutral/normalize.js",
      "default": "./dist/neutral/normalize.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js",
      "default": "./dist/live.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "bin": {
    "irsdk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts ./src/ibt.ts ./src/live.ts ./src/constants.ts ./src/cli.ts ./src/telemetry-server.ts ./src/types.ts ./src/binary-reader.ts --outdir ./dist --target bun --splitting && bun run build:neutral",
    "build:neutral": "bun build ./src/ibt.ts ./src/normalize.ts --outdir ./dist/neutral --target browser --splitting",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir ./dist",
    "build:server": "bun build ./src/telemetry-server.ts --compile --outfile ./dist/hotlap-telemetry",
    "clean": "rm -rf dist",
    "dev": "bun --watch src/cli.ts",
    "dashboard": "bun run examples/dashboard-server.ts",
    "server": "bun run src/telemetry-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run bench/parse-ibt.bench.ts",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "mitata": "^1.0.10",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "iracing",
    "telemetry",
    "ibt",
    "racing",
    "simulator",
    "bun",
    "sim-racing",
    "motorsport",
    "data-logging"
  ],
  "author": "HotLap.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotlap-ai/telemetry.git"
  },
  "homepage": "https://github.com/hotlap-ai/telemetry#readme",
  "bugs": {
    "url": "https://github.com/hotlap-ai/telemetry/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
